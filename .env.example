# Скопіюйте цей файл у .env і заповніть значення: cp .env.example .env
# Справжній .env не потрапляє в git (він у .gitignore).

# Секретний ключ Django (обов'язково). Згенерувати новий:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Режим розробки: True — локально, False — на сервері.
DEBUG=True

# Домени, з яких сервер приймає запити, через кому. Порожньо — лише localhost (і лише при DEBUG=True).
ALLOWED_HOSTS=localhost,127.0.0.1

# Адреси фронтенду, яким дозволені запити до API (CORS), через кому (обов'язково).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
